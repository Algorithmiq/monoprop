"""MPI ABI families this build of monoprop ships. Generated by CMake from cmake/_mpi_abis.py.in."""

from __future__ import annotations

ABIS: tuple[str, ...] = (@monoprop_MPI_ABIS_PY@)

# Version floors per MPI implementation, from cmake/custom/monopropMPIABI.cmake.
MIN_VERSIONS: dict[str, tuple[int, ...]] = {@monoprop_MPI_MIN_VERSIONS_PY@}

MODULE_FILES: dict[str, str] = {@monoprop_MPI_MODULE_FILES_PY@}
