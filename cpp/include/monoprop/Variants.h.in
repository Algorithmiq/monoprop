#pragma once

#include <string_view>

// Configured once per ISA variant by _monoprop_generate_variant_header (cmake/compiler_flags/
// CXXFlags.cmake). A fat-binary build writes one copy per tier into a per-tier include directory
// which that tier's object library searches first, so these two answers are the tier's own -- they
// are how a loaded variant is identified from Python, which is the only way to tell whether the
// import-time dispatch picked what it was supposed to.
//
// The identity is per *translation unit*, not per function: monoprop tiers whole libraries rather
// than multiversioning individual functions, because the vectorization the tiers buy lands in headers
// that are inlined into their callers, and a per-function dispatch seam would suppress that inlining.
// This header therefore carries no target attributes; there is nothing to attach them to.

namespace monoprop {
/// Identifier of the ISA variant this translation unit was compiled for.
consteval auto variant() noexcept -> std::string_view {
    return "@monoprop_VARIANT_ID@";
}

/// Machine-dependent flags the compiler resolved for this variant, space separated.
consteval auto variant_flags() noexcept -> std::string_view {
    return "@monoprop_VARIANT_MACHINE_FLAGS@";
}
} // namespace monoprop
