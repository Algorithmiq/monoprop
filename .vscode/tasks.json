{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Install in Release mode",
            "type": "shell",
            "command": "uv sync --all-extras -v --config-settings-package='monoprop:cmake.define.monoprop_ENABLE_CXX_UNIT_TESTS=ON'",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Install in Debug mode",
            "type": "shell",
            "command": "uv sync --all-extras -v --config-settings-package='monoprop:cmake.build-type=Debug' --config-settings-package='monoprop:cmake.define.monoprop_ENABLE_CXX_UNIT_TESTS=ON'",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Install in Coverage mode",
            "type": "shell",
            "command": "uv sync --all-extras -v --config-settings-package='monoprop:cmake.build-type=Coverage' --config-settings-package='monoprop:cmake.define.monoprop_ENABLE_CXX_UNIT_TESTS=ON'",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        }
    ]
}
