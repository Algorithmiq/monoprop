# Site configuration for octave_point.sbatch. Copy it anywhere (it is passed by path, so it
# never needs to live in the repository), fill it in, and hand the path to octave_point.sbatch.
# It is sourced on the compute node, so every path must be one the compute node can see.

# Slurm client binaries, if they are not on PATH already (AWS PCS installs them here).
PATH="$PATH:/opt/aws/pcs/scheduler/slurm-25.11/bin"
PARTITION=hpc-qa-queue

# monoprop built ON A COMPUTE NODE (Release builds use -march=native) with
# monoprop_MAX_NUM_MODES >= 1024; the PyPI wheel is capped at 250 and cannot run N >= 256.
PYTHON=/path/to/venv/bin/python
PPVM_PYTHON="$PYTHON"
# Julia >= 1.11 (MajoranaPropagation 0.4.1 needs LinearAlgebra >= 1.11); the figure used 1.12.7.
JULIA=/path/to/julia-1.12/bin/julia
JULIA_DEPOT_PATH=/path/to/private/julia-depot

# Where rows and logs land. Must be shared storage: each job runs on a different node.
RUN_DIR=/shared/path/octave_runs

# Optional. Compute nodes on the AWS PCS cluster have no /home, and Python and Julia both
# fail on ~/.cache and ~/.julia without one, so point HOME at shared storage there.
JOB_HOME=/shared/path/octave_runs/_home

# Optional. A file sourced once by campaign.sbatch before the first point, for whatever the
# compute node needs at run time (a compiler runtime, modules).
# SITE_SETUP=/path/to/env.sh

# The campaign's knobs (campaign.sbatch), as the figure was measured: small, medium and large
# depths, the Hubbard support cutoff, 30 min per point, and the points recorded as implied
# timeouts when the same engine exceeded the limit one depth lower at the same N.
HUBBARD_CUTOFF=3
# PAULI_LAYERS="7 10 13"
# HUBBARD_LAYERS="3 4 5"
# CEILING_S=1800
# IMPLIED="julia:10:1024=exceeded-at-7-layers julia-majorana:5:512=exceeded-at-4-layers ..."
# IMPLIED_IF="julia:13:512<julia:10:512 ppvm:13:256<ppvm:10:256"
# Optional: SETTLED_IN (earlier run directories whose settled rows are reused), MAX_N, IMPLIED,
# SETUP_S=600, MAX_ROUNDS=10, MAX_CONCURRENCY (default: one worker per NUMA domain), ROWS, NS.
