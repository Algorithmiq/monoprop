# CPython import-time marshal/object allocations when loading an instrumented
# extension into an unsanitized interpreter.
leak:_PyObject_Malloc
leak:r_object
leak:read_object
leak:marshal_loads
leak:_PyCode_New

# NumPy allocator/type-initialization leaks observed at interpreter shutdown.
leak:default_malloc
leak:default_calloc
leak:PyDataMem_UserNEW
leak:PyArray_NewFromDescr_int
leak:PyArray_IntpConverter
leak:PyUFunc_FromFuncAndDataAndSignatureAndIdentity
leak:NpyString_new_allocator
leak:__pyx_pymod_exec__mt19937
leak:_PyUnicodeWriter_Finish
leak:_PyObject_Realloc
leak:rlock_new
leak:PyThread_allocate_lock
leak:list_pop

# mpi4py imports initialize Open MPI internals even when tests run without
# --with-mpi; those allocations persist to process exit in unsanitized libmpi.
leak:__pyx_f_6mpi4py_3MPI_bootstrap
leak:ompi_mpi_init
leak:ompi_mpi_instance_init
leak:ompi_comm_init_mpi3
leak:list_extend
leak:pmix_hash_fetch
leak:PMIx_Value_create
leak:pmix_bfrops_base_value_load
leak:event_base_loop
