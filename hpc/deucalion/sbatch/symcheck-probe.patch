+// TEMPORARY falsification probe -- not for merge.
+//
+// Claim under test: the exchange count matrix is SYMMETRIC, i.e. what I send to r equals what r
+// sends to me, so resolve_recv's alltoall_counts is unnecessary and the retained transpose cache
+// (8 B per world slot, 10.59 GiB at P=512) can be deleted outright. Derived from Engine.h's
+// sink: slot r on my rank holds in_entries (queries r sent me) ++ out_entries (queries I sent
+// r), and slot me on rank r holds those two swapped -- so P+Q is equal on both sides.
+//
+// Reports through a FILE, not stderr: pytest's fd capture eats C++ stderr. Written from the
+// CONSTRUCTOR and again on every resolve, never only at exit -- measured, the static destructor
+// does not run under this interpreter, and a probe that reports only at exit produces zero files,
+// which reads identically to "no cross-rank traffic" and is worth nothing.
+struct SymmetryProbe final {
+    const char *out = std::getenv("MONOPROP_SYMCHECK");
+    std::atomic<uint64_t> resolves{0};
+    std::atomic<uint64_t> slots{0};
+    std::atomic<uint64_t> mismatched_resolves{0};
+    std::atomic<uint64_t> mismatched_slots{0};
+    std::atomic<uint64_t> first_send{0};
+    std::atomic<uint64_t> first_recv{0};
+    std::atomic<int> first_slot{-1};
+
+    auto report() -> void {
+        if (out == nullptr) {
+            return;
+        }
+        const std::string path = std::string(out) + "." + std::to_string(::getpid());
+        FILE *f = std::fopen(path.c_str(), "w");
+        if (f == nullptr) {
+            return;
+        }
+        std::fprintf(f,
+                     "resolves=%llu slots=%llu mismatched_resolves=%llu mismatched_slots=%llu "
+                     "first_bad_slot=%d first_send=%llu first_recv=%llu\n",
+                     static_cast<unsigned long long>(resolves.load()),
+                     static_cast<unsigned long long>(slots.load()),
+                     static_cast<unsigned long long>(mismatched_resolves.load()),
+                     static_cast<unsigned long long>(mismatched_slots.load()),
+                     first_slot.load(),
+                     static_cast<unsigned long long>(first_send.load()),
+                     static_cast<unsigned long long>(first_recv.load()));
+        std::fclose(f);
+    }
+
+    SymmetryProbe() { report(); }
+    ~SymmetryProbe() { report(); }
+};
+SymmetryProbe g_symmetry_probe;
+} // namespace
