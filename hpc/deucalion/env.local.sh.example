# Copy to env.local.sh (untracked) and fill in for your allocation.
#
# The Slurm account suffix selects the hardware budget and must match the
# partition, or the job is rejected at submit time:
#
#   ...260a  ->  dev-arm, normal-arm, large-arm, ooda
#   ...260x  ->  dev-x86, normal-x86, large-x86
#   ...260g  ->  dev-a100-40, normal-a100-40, dev-a100-80, normal-a100-80
#
# `billing` prints the accounts you hold and their remaining hours.
# Your DEFAULT account is the ARM one, so -A must always be passed explicitly.

export MONOPROP_PROJECT_DIR=/projects/EEHPC-DEV-2026D08-260
export MONOPROP_SLURM_ACCOUNT=eehpc-dev-2026d08-260x
