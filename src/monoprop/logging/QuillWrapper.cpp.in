#include "QuillWrapper.h"
#include "Utils.h"

#include <cstdlib>

#include <quill/Backend.h>
#include <quill/Frontend.h>
#include <quill/Logger.h>
#include <quill/core/LogLevel.h>
#include <quill/core/PatternFormatterOptions.h>
#include <quill/sinks/ConsoleSink.h>

namespace monoprop::logging {
auto global_logger() -> quill::Logger*& {
    static quill::Logger* logger = nullptr;
    return logger;
}

auto log_level() -> quill::LogLevel {
    const char* val = std::getenv("monoprop_LOG_LEVEL");
    return quill::loglevel_from_string((val) ? val : "@monoprop_DEFAULT_LOG_LEVEL@");
}

auto log_pattern_formatter_options() -> quill::PatternFormatterOptions {
    return quill::PatternFormatterOptions{
        "[%(time)][%(logger:<12) %(log_level:<9)][TID: %(thread_id), PID: %(process_id)]@_caller_file_line@ %(message)",
        "%Y-%m-%d %H:%M:%S"};
}

auto setup_quill() -> void {
    // start the backend thread
    quill::Backend::start();

    // setup sink and logger
    auto console_sink = quill::Frontend::create_or_get_sink<quill::ConsoleSink>("sink_id_1");
    global_logger() =
        quill::Frontend::create_or_get_logger("monoprop._core", std::move(console_sink), log_pattern_formatter_options());
}
} // namespace monoprop::logging
