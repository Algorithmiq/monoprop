#include "binder.h"

#include <nanobind/nanobind.h>

#include "generated/bind.h"
#include "monoprop/Info.h"
#include "monoprop/MPFunctions.h"
#include "monoprop/detail/mpi/MPICompat.h"

using namespace monoprop;
using namespace nanobind::literals;

namespace monoprop::bindings::detail {
auto cutoff_type_str_2_enum(const std::string &cutoff_type) -> CutoffType {
    if (cutoff_type == "length") {
        return monoprop::CutoffType::Length;
    }
    else if (cutoff_type == "support") {
        return monoprop::CutoffType::Support;
    }
    else {
        throw std::invalid_argument(
            std::format("Unknown CutoffType string: '{}'. Valid options are: 'length', 'support'.",
                        cutoff_type));
    }
}

auto cutoff_type_enum_2_str(CutoffType cutoff_type) -> std::string {
    switch (cutoff_type) {
        case monoprop::CutoffType::Length:
            return "length";
        case monoprop::CutoffType::Support:
            return "support";
        default:
            throw std::invalid_argument("Unknown CutoffType enum value");
    }
}

auto basis_str_2_enum(const std::string &basis) -> Basis {
    if (basis == "majorana") {
        return monoprop::Basis::Majorana;
    }
    else if (basis == "pauli") {
        return monoprop::Basis::Pauli;
    }
    else {
        throw std::invalid_argument(
            std::format("Unknown Basis string: '{}'. Valid options are: 'majorana', 'pauli'.", basis));
    }
}

auto basis_enum_2_str(Basis basis) -> std::string {
    switch (basis) {
        case monoprop::Basis::Majorana:
            return "majorana";
        case monoprop::Basis::Pauli:
            return "pauli";
        default:
            throw std::invalid_argument("Unknown Basis enum value");
    }
}
} // namespace monoprop::bindings::detail

NB_MODULE(monoprop_PY_MODULE_NAME, m) {
    m.doc() = "Monomial Propagator";

    monoprop::bindings::detail::init_comm_bridge();

    // clang-format off
    m.attr("MAX_NUM_MODES") = static_cast<size_t>(@monoprop_MAX_NUM_MODES@);
    // clang-format on
    m.attr("__build_type__") = std::string(build_type());
    m.attr("__compiler_flags__") = compiler_flags();
    m.attr("__nanobind_version__") = std::string("@nanobind_VERSION@");
    m.attr("__variant__") = std::string(variant());

    m.def("is_antihermitian",
          &monoprop::is_antihermitian,
          "indices"_a,
          "Check if a Majorana operator (represented by indices) is antihermitian.");
    m.def("antihermitian_generator_correction",
          &monoprop::antihermitian_generator_correction,
          "indices"_a,
          "Get the generator correction for a Majorana operator (represented by indices).");
    // clang-format off
    @_BINDINGS_BODY_@
    // clang-format on
}
